# 复制成 .env 后填写。.env 绝对不要提交到 git。

# ---- 凭据（必填）----
# https://my.telegram.org/apps 申请
API_ID=
API_HASH=

# @BotFather 创建机器人后拿到的 token
BOT_TOKEN=

# 机器人用户名，不带 @
BOT_USERNAME=

# ---- 权限 ----
# 允许触发的 Telegram 用户 ID，逗号分隔。留空 = 不限制。
# 自己的 ID 可以问 @userinfobot
ALLOWED_USERS=

# 状态消息发到哪个用户 ID。留空 = 用 ALLOWED_USERS 里的第一个。
NOTIFY_USER=

# ---- 目录 ----
# 部署到群晖容器：用下面这两个容器内路径（跟 docker-compose.yml 的挂载对应）
# 在 Windows 本机跑：改成相对路径 ./downloads 和 ./data，文件会落在项目目录里
#   （本机跑时若留着 /data，文件会跑到 C:\data 去，很容易找不到）
DOWNLOAD_DIR=/downloads
SESSION_DIR=/data

# ---- 网络代理 ----
# 中国大陆访问 Telegram 必须配，否则连不上。全部留空 = 直连。
# PROXY_TYPE 可选：socks5 / socks4 / http / mtproxy
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
# SOCKS / HTTP 代理的用户名密码，不需要就留空
PROXY_USER=
PROXY_PASS=
# 仅 PROXY_TYPE=mtproxy 时填。必须是 hex 格式的 secret（32 位十六进制）
PROXY_SECRET=

# ---- 行为 ----
# 按来源频道 / 群组建子目录
GROUP_BY_SOURCE=true
# 按文件类型建子目录（图片/视频/音频/文档…）
GROUP_BY_TYPE=true
# 同时下载几个文件
MAX_CONCURRENT=2
# 单文件大小上限 MB，0 = 不限制
MAX_FILE_MB=2000
# 同一文件重复转发是否跳过
SKIP_DUPLICATE=true
